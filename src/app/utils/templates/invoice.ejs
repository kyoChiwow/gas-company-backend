<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      @page {
        size: A4;
        margin: 0;
      }
      body {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        color: #1e293b;
        line-height: 1.5;
        background-color: #ffffff;
        margin: 0;
        padding: 0;
        -webkit-print-color-adjust: exact;
      }
      .invoice-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 40px;
        background: #ffffff;
      }
      
      /* Typography Updates */
      h1, h2, h3, h4 {
        margin: 0;
        font-weight: 700;
        color: #0f172a;
      }
      
      /* Robust Layout Fix for PDF Engines */
      .layout-table {
        width: 100%;
        border-collapse: collapse;
        border: 0;
        margin-bottom: 30px;
      }
      .layout-table td {
        padding: 0;
        border: 0;
        vertical-align: top;
      }
      
      /* Header Design */
      .brand-title {
        font-size: 26px;
        letter-spacing: -0.5px;
        color: #0f172a;
      }
      .brand-subtitle {
        font-size: 12px;
        color: #ea580c; /* Orange accent matching your brand layout colors */
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 2px;
      }
      .invoice-heading {
        font-size: 32px;
        font-weight: 800;
        color: #0f172a;
        text-align: right;
        line-clamp: 1;
      }
      
      /* Divider Bar */
      .divider {
        height: 2px;
        background-color: #f1f5f9;
        margin: 24px 0;
      }

      /* Metadata Subheaders */
      .meta-title {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 6px;
      }
      .meta-value {
        font-size: 14px;
        color: #334155;
      }
      .meta-value strong {
        color: #0f172a;
      }

      /* Itemized Grid Layout Table */
      .item-table {
        width: 100%;
        border-collapse: collapse;
        margin: 40px 0 20px 0;
      }
      .item-table th {
        background-color: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        padding: 14px 16px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #475569;
        text-align: left;
      }
      .item-table td {
        padding: 16px;
        border-bottom: 1px solid #f1f5f9;
        font-size: 14px;
        color: #334155;
      }
      .text-right {
        text-align: right !important;
      }
      
      /* Summary Pricing Card Block */
      .total-wrapper-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      .total-card {
        width: 280px;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
      }
      .total-row td {
        padding: 6px 0;
        font-size: 14px;
        color: #475569;
      }
      .grand-total-row td {
        padding-top: 10px;
        border-top: 1px dashed #cbd5e1;
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
      }
      .currency-badge {
        font-size: 12px;
        color: #64748b;
        font-weight: 500;
        margin-left: 2px;
      }

      /* Clean Minimal Footer block */
      .footer {
        margin-top: 80px;
        border-top: 1px solid #f1f5f9;
        padding-top: 20px;
        text-align: center;
      }
      .footer p {
        margin: 0 0 4px 0;
        font-size: 12px;
        color: #94a3b8;
      }
      .footer .terms {
        font-size: 11px;
        color: #cbd5e1;
      }
    </style>
  </head>
  <body>
    <div class="invoice-container">
      
      <table class="layout-table">
        <tr>
          <td>
            <div class="brand-title">Taher Enterprise</div>
            <div class="brand-subtitle">Energy & Supply Solutions</div>
          </td>
          <td class="text-right">
            <div class="invoice-heading">INVOICE</div>
          </td>
        </tr>
      </table>

      <div class="divider"></div>

      <table class="layout-table" style="margin-bottom: 10px;">
        <tr>
          <td style="width: 50%;">
            <div class="meta-title">Billed To</div>
            <div class="meta-value">
              <strong><%= userName %></strong>
            </div>
          </td>
          <td style="width: 25%;">
            <div class="meta-title">Date Issued</div>
            <div class="meta-value"><%= new Date(quotaDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></div>
          </td>
          <td style="width: 25%;" class="text-right">
            <div class="meta-title">Transaction ID</div>
            <div class="meta-value" style="font-family: monospace; font-weight: 600; color: #0f172a;"><%= transactionId %></div>
          </td>
        </tr>
      </table>

      <table class="item-table">
        <thead>
          <tr>
            <th style="width: 45%;">Product Description</th>
            <th style="width: 15%;">Volume</th>
            <th style="width: 20%;">Supply Type</th>
            <th style="width: 20%;" class="text-right">Amount Paid</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td style="font-weight: 600; color: #0f172a;"><%= productName %></td>
            <td><%= volume %></td>
            <td>
              <span style="font-size: 13px; font-weight: 500;"><%= cylinderOrRefill %></span>
            </td>
            <td class="text-right" style="font-weight: 600; color: #0f172a;">
              ৳ <%= totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </td>
          </tr>
        </tbody>
      </table>

      <table class="total-wrapper-table">
        <tr>
          <td></td>
          <td style="width: 280px;">
            <div class="total-card">
              <table style="width: 100%; border-collapse: collapse;">
                <tr class="total-row">
                  <td>Subtotal</td>
                  <td class="text-right">৳ <%= totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                </tr>
                <tr class="total-row">
                  <td>VAT / Tax (0%)</td>
                  <td class="text-right">৳ 0.00</td>
                </tr>
                <tr class="grand-total-row">
                  <td>Total Paid</td>
                  <td class="text-right" style="color: #ea580c;">
                    ৳ <%= totalAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    <span class="currency-badge">BDT</span>
                  </td>
                </tr>
              </table>
            </div>
          </td>
        </tr>
      </table>

      <div class="footer">
        <p style="color: #475569; font-weight: 500;">Thank you for your business with Taher Enterprise!</p>
        <p>This document is a digitally authorized automated transaction invoice receipt.</p>
        <p class="terms">System Reference: <%= transactionId.slice(-8).toUpperCase() %> • Operations Support Automated Pipeline</p>
      </div>

    </div>
  </body>
</html>